  patient            CpPatient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([assessorId])
  @@index([outcomeDirection])
  @@index([reviewDate])
}

model ActivityParticipationLog {
  id               String          @id @default(uuid())
  patientId        String
  providerId       String
