  actionType        String
  actionDetails     Json             @default("{}")
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime         @default(now())
  serviceProvider   ServiceProvider? @relation(fields: [serviceProviderId], references: [id])
  serviceProviderId String?

  @@index([roomId])
  @@index([userId])
  @@index([createdAt])
