generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                  @id @default(uuid())
  fullName                     String
  email                        String?                 @unique
  password                     String
  phoneNumber                  String                  @unique
  profileImage                 String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  profileCompleted             Boolean                 @default(false)
  verified                     Boolean                 @default(false)
  gender                       Gender
  address                      String?
  digitalAddress               String?
  dateOfBirth                  DateTime
  accountStatus                AccountStatus           @default(ACTIVE)
  userType                     UserType
  googleAccessToken            String?
  googleRefreshToken           String?
  caregiver                    CareGiver?
  chatSessions                 ChatSession[]
  createdCommunities           Community[]             @relation("CommunityCreator")
  communityAnnouncements       CommunityAnnouncement[]
  communityGroupMembers        CommunityGroupMember[]
  communityInvitations         CommunityInvitation[]
  communityMemberships         CommunityMember[]
  communityMessages            CommunityMessage[]
  uploadedGames                GameResource[]          @relation("UserUploadedGames")
  notifications                Notification[]
  otp                          Otp?
  passwordResetTokens          PasswordResetToken[]
  pushNotificationTokens       PushNotificationToken[] @relation("UserPushTokens")
  refreshToken                 RefreshToken[]
  submittedReports             Report[]                @relation("UserReports")
  reportedBy                   Report[]                @relation("ReportedUsers")
  supportTickets               SupportTicket[]         @relation("UserTickets")
  telehealthAccessCreated      TelehealthAccessToken[] @relation("AccessCreatedBy")
  telehealthAuditLogs          TelehealthAuditLog[]
  telehealthInvitations        TelehealthInvitation[]
  telehealthInvitationsInvited TelehealthInvitation[]  @relation("InvitationInviter")
  telehealthMessagesSent       TelehealthMessage[]     @relation("TeleMessageSender")
  telehealthParticipants       TelehealthParticipant[]
  telehealthRoomsCreated       TelehealthRoom[]        @relation("RoomCreator")
  ticketMessages               TicketMessage[]         @relation("TicketMessageSender")
  userPermissions              UserPermission[]
  userRoles                    UserRole[]
  receivedDirectMessages       DirectMessage[]         @relation("DirectMessageReceiver")
  sentDirectMessages           DirectMessage[]         @relation("DirectMessageSender")
  resources                    Resource[]
  serviceProvider              ServiceProvider?
  userSignatures               UserSignature[]
  documentSignatures           DocumentSignature[]
}

model Otp {
  id         String    @id @default(uuid())
  codeHash   String?
  userId     String    @unique
  expiresAt  DateTime?
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  prefix     String?
  requestId  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceProvider {
  id                        String                     @id @default(uuid())
  userId                    String                     @unique
  licenseNumber             String
  licenseImage              String?
  licenseExpiry             DateTime
  licenseIssuedBy           String?
  licenseIssuedDate         DateTime
  licenseStatus             LicenseStatus              @default(INACTIVE)
  facilityType              FacilityType
  facilityName              String
  facilityAddress           String
  experience                Int
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  profession                Profession
  licenseType               ProfessionalBody
  licensePin                String
  verificationStatus        VerificationStatus         @default(PENDING_REVIEW)
  verificationNote          String?
  verifiedAt                DateTime?
  verifiedBy                String?
  participationLogs         ActivityParticipationLog[]
  appointments              Appointment[]
  clinicalAssessments       ClinicalAssessment[]       @relation("ProviderAssessments")
  clinicalReferrals         ClinicalReferral[]         @relation("ProviderReferrals")
  incomingReferrals         ClinicalReferral[]         @relation("ReferralRecipients")
  functionalClassifications FunctionalClassification[]
  providerGames             GameResource[]             @relation("ProviderUploadedGames")
  motorFunctionOutcomes     MotorFunctionOutcome[]
  availabilities            ProviderAvailability[]
  providerMetrics           ProviderMetricsSnapshot[]
  rehabTasks                RehabTask[]
  adherenceLogs             TaskAdherenceLog[]
  telehealthAuditLogs       TelehealthAuditLog[]
  telehealthIntegrations    TelehealthIntegration[]    @relation("IntegrationOwner")
  telehealthRecordings      TelehealthRecording[]
  telehealthRoomsProvided   TelehealthRoom[]           @relation("ProviderForRoom")
  resources                 Resource[]
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@map("serviceProvider")
}

model ProviderAvailability {
  id         String          @id @default(uuid())
  providerId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model CareGiver {
  id                    String          @id @default(uuid())
  type                  CaregiverType
  userId                String?         @unique
  occupation            String?
  educationLevel        EducationLevel?
  idType                IdType?
  idNumber              String?
  nameOfGroup           String?
  locationOfGroup       String?
  groupContact          String?
  groupDigitalAddress   String?
  groupEmail            String?
  managerName           String?         @map("ManagerName")
  managerContact        String?
  verificationDocuments String[]
  isVerified            Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cpPatients            CpPatient[]
}

model CpPatient {
  id                        String                     @id @default(uuid())
  fullName                  String
  dateOfBirth               DateTime
  gender                    Gender
  address                   String
  placeOfBirth              String
  birthWeight               Float?
  numberOfSiblings          Int?
  caregiverId               String
  relationToCaregiver       Relationship
  householdSize             Int
  schoolEnrollmentStatus    Boolean                    @default(false) @map("schoolEnrollmmentStatus")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  typeOfSchool              SchoolType?
  participationLogs         ActivityParticipationLog[]
  appointments              Appointment[]
  clinicalAssessments       ClinicalAssessment[]
  clinicalReferrals         ClinicalReferral[]
  functionalClassifications FunctionalClassification[]
  motorFunctionOutcomes     MotorFunctionOutcome[]
  enrollmentRecord          PatientEnrollmentRecord?
  patientMetrics            PatientMetricsSnapshot[]
  rehabTasks                RehabTask[]
  adherenceLogs             TaskAdherenceLog[]
  caregiver                 CareGiver                  @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@index([caregiverId])
  @@map("cpPatient")
}

model FunctionalClassification {
  id         String                   @id @default(uuid())
  patientId  String
  level      Int
  assessedAt DateTime
  assessorId String?
  notes      String?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  classifier FunctionalClassifierType
  assessor   ServiceProvider?         @relation(fields: [assessorId], references: [id])
  patient    CpPatient                @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([assessorId])
  @@index([classifier])
}

model ClinicalAssessment {
  id          String                     @id @default(uuid())
  patientId   String
  providerId  String
  toolCode    String
  toolVersion String
  status      AssessmentStatus           @default(DRAFT)
  assessedAt  DateTime?
  responses   Json
  referralId  String?                    @unique
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  patient     CpPatient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider    ServiceProvider            @relation("ProviderAssessments", fields: [providerId], references: [id], onDelete: Cascade)
  referral    ClinicalReferral?          @relation("ReferralAssessment", fields: [referralId], references: [id])
  reports     ClinicalAssessmentReport[]

  @@index([patientId])
  @@index([providerId])
}

model ClinicalAssessmentReport {
  id              String             @id @default(uuid())
  assessmentId    String
  summary         String?
  scores          Json
  interpretation  String?
  recommendations Json?
  createdAt       DateTime           @default(now())
  assessment      ClinicalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model ClinicalReferral {
  id                String              @id @default(uuid())
  patientId         String
  fromProviderId    String
  toProfession      Profession
  reason            String
  status            ReferralStatus      @default(PENDING)
  createdAt         DateTime            @default(now())
  toProviderId      String?
  relatedAssessment ClinicalAssessment? @relation("ReferralAssessment")
  fromProvider      ServiceProvider     @relation("ProviderReferrals", fields: [fromProviderId], references: [id], onDelete: Cascade)
  patient           CpPatient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  toProvider        ServiceProvider?    @relation("ReferralRecipients", fields: [toProviderId], references: [id])
  generatedTasks    RehabTask[]

  @@index([patientId])
  @@index([fromProviderId])
  @@index([toProviderId])
}

model RehabTask {
  id                    String                     @id @default(uuid())
  patientId             String
  providerId            String
  title                 String
  instructions          String
  instructionSteps      Json?
  frequencyPerDay       Int?
  frequencyNote         String?
  durationDays          Int
  startDate             DateTime?
  endDate               DateTime?
  status                RehabTaskStatus            @default(PENDING)
  completedAt           DateTime?
  referralId            String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  progress              Int                        @default(0)
  caregiverMarkedDoneAt DateTime?
  completedDates        String[]                   @default([])
  videoUrl              String?
  participationLogs     ActivityParticipationLog[]
  patient               CpPatient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider              ServiceProvider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  referral              ClinicalReferral?          @relation(fields: [referralId], references: [id])
  adherenceLogs         TaskAdherenceLog[]

  @@index([patientId])
  @@index([providerId])
  @@index([referralId])
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  providerId      String
  appointmentDate DateTime
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  reasonAudio     String?
  reasonText      String?
  patient         CpPatient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider        ServiceProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([providerId])
}

model AssessmentTool {
  id          String                     @id @default(uuid())
  toolCode    String                     @unique
  toolName    String
  version     String
  description String?
  schema      Json?
  isActive    Boolean                    @default(true)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  professions AssessmentToolProfession[]
}

model AssessmentToolProfession {
  id         String         @id @default(uuid())
  toolId     String
  profession Profession
  createdAt  DateTime       @default(now())
  tool       AssessmentTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, profession])
}

model VideoCache {
  id         String   @id @default(uuid())
  cacheKey   String   @unique
  cachedData Json
  pageInfo   Json?
  lastFetch  DateTime @default(now())
  ttl        Int      @default(3600)
  isValid    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Community {
  id            String                  @id @default(uuid())
  name          String
  description   String?
  image         String?
  createdBy     String
  inviteCode    String?                 @unique
  inviteEnabled Boolean                 @default(true)
  maxMembers    Int                     @default(1000)
  isPublic      Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  creator       User                    @relation("CommunityCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  announcements CommunityAnnouncement[]
  groups        CommunityGroup[]
  invitations   CommunityInvitation[]
  members       CommunityMember[]

  @@index([createdBy])
  @@index([inviteCode])
}

model CommunityMember {
  id          String                @id @default(uuid())
  communityId String
  userId      String
  role        CommunityMemberRole   @default(MEMBER)
  status      CommunityMemberStatus @default(ACTIVE)
  joinedAt    DateTime              @default(now())
  invitedBy   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@index([communityId, status])
}

model CommunityGroup {
  id                 String                 @id @default(uuid())
  communityId        String
  name               String
  description        String?
  image              String?
  createdBy          String
  isDefault          Boolean                @default(false)
  isAnnouncementOnly Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  community          Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members            CommunityGroupMember[]
  messages           CommunityMessage[]

  @@index([communityId])
  @@index([createdBy])
}

model CommunityGroupMember {
  id        String          @id @default(uuid())
  groupId   String
  userId    String
  role      GroupMemberRole @default(MEMBER)
  joinedAt  DateTime        @default(now())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  group     CommunityGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model CommunityMessage {
  id        String             @id @default(uuid())
  groupId   String
  senderId  String
  content   String?
  type      MessageType        @default(TEXT)
  mediaUrl  String?
  metadata  Json?
  status    MessageStatus      @default(SENT)
  replyToId String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @default(now())
  dislikes  Int                @default(0)
  likes     Int                @default(0)
  caption   String?
  group     CommunityGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  replyTo   CommunityMessage?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   CommunityMessage[] @relation("MessageReplies")
  sender    User               @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([senderId])
  @@index([createdAt])
}

model CommunityAnnouncement {
  id          String    @id @default(uuid())
  communityId String
  title       String
  content     String
  mediaUrl    String?
  createdBy   String
  isPinned    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  caption     String?
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creator     User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([createdBy])
}

model CommunityInvitation {
  id          String    @id @default(uuid())
  communityId String
  invitedBy   String
  invitedUser String?
  phoneNumber String?
  email       String?
  code        String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  inviter     User      @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([code])
  @@index([invitedBy])
}

model Resource {
  id                String           @id @default(uuid())
  title             String
  description       String?
  type              ResourceType     @default(DOCUMENT)
  resourceUrl       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now())
  serviceProviderId String?
  userId            String?
  serviceProvider   ServiceProvider? @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  user              User?            @relation(fields: [userId], references: [id])

  @@index([serviceProviderId])
  @@map("resource")
}

model Notification {
  id           String               @id @default(uuid())
  userId       String
  type         NotificationType
  category     NotificationCategory
  title        String
  content      String?
  data         Json?
  status       NotificationStatus   @default(UNREAD)
  relatedId    String?
  relatedModel String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now())
  expiresAt    DateTime?
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([type, category])
}

model PushNotificationToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  deviceType String
  deviceId   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  user       User     @relation("UserPushTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isActive])
}

model DirectMessage {
  id         String              @id @default(uuid())
  senderId   String
  receiverId String
  content    String?
  mediaUrl   String?
  type       MessageType         @default(TEXT)
  status     DirectMessageStatus @default(SENT)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @default(now())
  caption    String?
  receiver   User                @relation("DirectMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User                @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([senderId, receiverId])
  @@map("directMessage")
}

model TelehealthIntegration {
  id                     String                   @id @default(uuid())
  organizationId         String
  providerName           String
  clientId               String?
  clientSecretEncrypted  Bytes?
  apiKeyEncrypted        Bytes?
  webhookSecretEncrypted Bytes?
  config                 Json                     @default("{}")
  defaultRegion          String?
  enabled                Boolean                  @default(true)
  ownerProviderId        String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now())
  ownerProvider          ServiceProvider?         @relation("IntegrationOwner", fields: [ownerProviderId], references: [id])
  oauthTokens            TelehealthOAuthToken[]
  telehealthRooms        TelehealthRoom[]         @relation("ProviderIntegrationRooms")
  webhookEvents          TelehealthWebhookEvent[]

  @@unique([organizationId, providerName])
  @@index([organizationId, providerName])
}

model TelehealthOAuthToken {
  id                    String                @id @default(uuid())
  integrationId         String
  tokenType             String?
  tokenEncrypted        Bytes
  expiresAt             DateTime?
  scope                 String?
  refreshTokenEncrypted Bytes?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now())
  integration           TelehealthIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
}

model TelehealthRoom {
  id                    String                  @id @default(uuid())
  organizationId        String
  creatorUserId         String
  title                 String?
  description           String?
  scheduledStart        DateTime?
  scheduledEnd          DateTime?
  status                TelehealthRoomStatus    @default(scheduled)
  visibility            TelehealthVisibility    @default(private)
  maxParticipants       Int                     @default(50)
  providerIntegrationId String?
  externalMeetingId     String?
  joinUrl               String?
  joinUrlExpiresAt      DateTime?
  providerPayload       Json                    @default("{}")
  isRecordingEnabled    Boolean                 @default(false)
  metadata              Json                    @default("{}")
  providedByProviderId  String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now())
  canceledAt            DateTime?
  canceledBy            String?
  accessTokens          TelehealthAccessToken[]
  auditLogs             TelehealthAuditLog[]
  invitations           TelehealthInvitation[]
  messages              TelehealthMessage[]
  participants          TelehealthParticipant[]
  recordings            TelehealthRecording[]
  creator               User                    @relation("RoomCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  providedByProvider    ServiceProvider?        @relation("ProviderForRoom", fields: [providedByProviderId], references: [id])
  providerIntegration   TelehealthIntegration?  @relation("ProviderIntegrationRooms", fields: [providerIntegrationId], references: [id])
  transcripts           TelehealthTranscript[]

  @@index([organizationId, status, scheduledStart])
  @@index([externalMeetingId])
  @@index([creatorUserId])
}

model TelehealthParticipant {
  id                    String                      @id @default(uuid())
  roomId                String
  userId                String?
  guestEmail            String?
  role                  TelehealthParticipantRole   @default(observer)
  status                TelehealthParticipantStatus @default(invited)
  externalParticipantId String?
  joinTokenHash         String?
  permissions           Json                        @default("{}")
  deviceInfo            Json                        @default("{}")
  metadata              Json                        @default("{}")
  joinedAt              DateTime?
  leftAt                DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @default(now())
  room                  TelehealthRoom              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user                  User?                       @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model TelehealthAccessToken {
  id            String         @id @default(uuid())
  roomId        String
  userId        String?
  tokenHash     String
  createdBy     String?
  expiresAt     DateTime?
  singleUse     Boolean        @default(true)
  scopes        String[]       @default([])
  metadata      Json           @default("{}")
  createdAt     DateTime       @default(now())
  usedAt        DateTime?
  createdByUser User?          @relation("AccessCreatedBy", fields: [createdBy], references: [id])
  room          TelehealthRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([tokenHash])
}

model TelehealthInvitation {
  id              String         @id @default(uuid())
  roomId          String
  inviterUserId   String
  inviteeUserId   String?
  inviteeEmail    String?
  inviteePhone    String?
  inviteTokenHash String?
  expiresAt       DateTime?
  status          String         @default("sent")
  deliveredVia    String?
  deliveredAt     DateTime?
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now())
  inviteeUser     User?          @relation(fields: [inviteeUserId], references: [id])
  inviter         User           @relation("InvitationInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  room            TelehealthRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([inviteeEmail])
}

model TelehealthMessage {
  id           String                     @id @default(uuid())
  roomId       String
  senderUserId String?
  senderRole   TelehealthParticipantRole?
  messageType  TelehealthMessageType      @default(text)
  content      String?
  attachments  Json                       @default("[]")
  sequence     Int                        @default(autoincrement())
  visibleTo    Json                       @default("null")
  metadata     Json                       @default("{}")
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime                   @default(now())
  room         TelehealthRoom             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender       User?                      @relation("TeleMessageSender", fields: [senderUserId], references: [id])

  @@index([roomId, createdAt])
  @@index([sequence])
}

model TelehealthRecording {
  id                  String                   @id @default(uuid())
  roomId              String
  providerRecordingId String?
  s3Bucket            String?
  s3Key               String?
  storageClass        String?
  encryptionKeyId     String?
  sizeBytes           BigInt?
  durationSeconds     Int?
  state               TelehealthRecordingState @default(processing)
  metadata            Json                     @default("{}")
  createdAt           DateTime                 @default(now())
  availableAt         DateTime?
  deletedAt           DateTime?
  serviceProviderId   String?
  room                TelehealthRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  serviceProvider     ServiceProvider?         @relation(fields: [serviceProviderId], references: [id])
  transcripts         TelehealthTranscript[]

  @@index([roomId])
  @@index([providerRecordingId])
}

model TelehealthTranscript {
  id                   String               @id @default(uuid())
  recordingId          String?
  roomId               String?
  providerTranscriptId String?
  language             String?
  fullText             String?
  segments             Json                 @default("[]")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now())
  recording            TelehealthRecording? @relation(fields: [recordingId], references: [id])
  room                 TelehealthRoom?      @relation(fields: [roomId], references: [id])

  @@index([roomId])
}

model TelehealthWebhookEvent {
  id              String                  @id @default(uuid())
  integrationId   String?
  providerEventId String?
  eventType       String?
  payload         Json
  receivedAt      DateTime                @default(now())
  processedAt     DateTime?
  status          TelehealthWebhookStatus @default(pending)
  attemptCount    Int                     @default(0)
