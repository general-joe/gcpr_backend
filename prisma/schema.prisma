model TelehealthIdempotencyKey {
  id        String    @id @default(uuid())
  key       String
  scope     String
  response  Json?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([key, scope])
}

model TelehealthRoleTemplate {
  id                 String                    @id @default(uuid())
  organizationId     String
  role               TelehealthParticipantRole
  defaultPermissions Json                      @default("{}")
  description        String?
  createdAt          DateTime                  @default(now())

  @@index([organizationId])
