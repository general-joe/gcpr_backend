model TelehealthTranscript {
  id                   String               @id @default(uuid())
  recordingId          String?
  recording            TelehealthRecording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  roomId               String?
  room                 TelehealthRoom?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  providerTranscriptId String?
  language             String?
  fullText             String? // long text
  segments             Json                 @default("[]") // [{start,end,speaker,text},...]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now())

  @@index([roomId])
}

model TelehealthWebhookEvent {
  id              String                  @id @default(uuid())
  integrationId   String?
  integration     TelehealthIntegration?  @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  providerEventId String?
  eventType       String?
  payload         Json // raw payload
  receivedAt      DateTime                @default(now())
  processedAt     DateTime?
  status          TelehealthWebhookStatus @default(pending)
