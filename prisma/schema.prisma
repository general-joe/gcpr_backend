/**
 * * ====== RBAC MODELS (kept) ====== **
 */

/**
 * Permission: small-codebook of capability strings. Examples: UPLOAD_GAME, MANAGE_GAMES, VIEW_GAMES, CREATE_ROOM, START_RECORDING, etc.
 * AppRole: logical role grouping multiple permissions (e.g., "ADMIN", "SERVICE_PROVIDER_ADMIN", "MODERATOR")
 * RolePermission: join table role -> permission
 * UserRole: a user's role assignment; optionally scoped to organization/service provider/community
 * UserPermission: direct per-user grant/deny (useful for overrides)
 */

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g., "UPLOAD_GAME", "MANAGE_GAMES"
  name        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  rolePermissions     RolePermission[]
  userPermissions     UserPermission[]
  gameRolePermissions GameRolePermission[]
}

model AppRole {
  id          String   @id @default(uuid())
  slug        String   @unique // e.g., "ADMIN", "SERVICE_PROVIDER"
  name        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  rolePermissions     RolePermission[]
  userRoles           UserRole[]
  gameRolePermissions GameRolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         AppRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      AppRole             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeType AssignmentScopeType @default(GLOBAL)
  scopeId   String? // optional: organizationId, serviceProviderId, communityId...
  grantedBy String? // user id who granted this role
  grantedAt DateTime            @default(now())
  expiresAt DateTime?
  active    Boolean             @default(true)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId])
  @@index([roleId])
}

model UserPermission {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission          @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  allowed      Boolean             @default(true) // true = grant, false = deny
  scopeType    AssignmentScopeType @default(GLOBAL)
  scopeId      String?
  grantedBy    String?
  grantedAt    DateTime            @default(now())

  @@unique([userId, permissionId, scopeType, scopeId])
  @@index([userId])
  @@index([permissionId])
}

/**
 * * ====== GAME (WELLBEING) MODELS (kept) ====== **
 */

/**
 * GameResource:
 * - allows uploads (files array) or external references (Youtube/external)
 * - uploaderUser/serviceProvider references
 * - publish state
 * - tags, thumbnail, metadata
 * - allowedRoles: optional array of AppRole slugs allowed to access or role-based mapping in GameRolePermission
 */

model GameResource {
  id                 String           @id @default(uuid())
  title              String
  description        String?
  source             GameSource       @default(UPLOADED)
  externalProvider   String? // e.g., "youtube"
  externalId         String? // external resource id
  files              String[]         @default([]) // uploaded file URLs (S3 keys)
  thumbnail          String?
  tags               String[]         @default([])
  isPublished        Boolean          @default(false)
  publishedAt        DateTime?
  metadata           Json             @default("{}")
  uploaderUserId     String
  uploaderUser       User             @relation("UserUploadedGames", fields: [uploaderUserId], references: [id], onDelete: Cascade)
  uploaderProviderId String? // optional: service provider uploader
  uploaderProvider   ServiceProvider? @relation("ProviderUploadedGames", fields: [uploaderProviderId], references: [id], onDelete: SetNull)
  allowedRoleSlugs   String[]         @default([]) // convenience: list of AppRole.slug allowed to access; app should enforce via UserRole lookup
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now())
  removedAt          DateTime?

  rolePermissions GameRolePermission[] // granular per-game role->permission mappings

  @@index([externalProvider, externalId])
  @@index([uploaderUserId])
  @@index([uploaderProviderId])
}

model GameRolePermission {
  id           String       @id @default(uuid())
  gameId       String
  game         GameResource @relation(fields: [gameId], references: [id], onDelete: Cascade)
  roleId       String
  role         AppRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([gameId, roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/**
 * * ====== METRICS & ADHERENCE MODELS (new) ====== **
 * Covers stakeholder requirements:
 * - Number of children attended to by each professional
 * - Number participating in each activity by each professional
 * - Number of children enrolled
 * - Number adhering / not adhering to daily activities
 * - Number with improved gross motor function outcomes
 * - System-wide and provider-level snapshots
 */

// ─────────────────────────────────────────────
// 1. DAILY TASK ADHERENCE LOG
//    Tracks per-day per-task adherence for each patient.
//    This augments the String[] completedDates on RehabTask
//    with a proper relational audit trail.
// ─────────────────────────────────────────────
model TaskAdherenceLog {
  id         String          @id @default(uuid())
  taskId     String
  task       RehabTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  patientId  String
  patient    CpPatient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  logDate    DateTime // The calendar date this log is for (date only; store as midnight UTC)
  status     AdherenceStatus @default(PENDING)
  markedById String? // userId who marked it (caregiver or provider)
  markedAt   DateTime?
  notes      String?
  metadata   Json            @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, logDate]) // one log per task per day
  @@index([patientId, logDate])
  @@index([providerId, logDate])
  @@index([status])
}

// ─────────────────────────────────────────────
// 2. PATIENT ENROLLMENT RECORD
//    Tracks formal enrollment of a CpPatient into the platform/program.
//    "Number of children enrolled" is COUNT of active EnrollmentRecord rows.
// ─────────────────────────────────────────────
model PatientEnrollmentRecord {
  id        String    @id @default(uuid())
  patientId String    @unique // one active enrollment per patient
  patient   CpPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  enrolledAt       DateTime         @default(now())
  enrolledByUserId String // user (caregiver or provider) who enrolled
  status           EnrollmentStatus @default(ACTIVE)
  programName      String? // optional: e.g., "CP Rehab Program 2026"
  unenrolledAt     DateTime?
  unenrollReason   String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([enrolledAt])
}

// ──────────────────────────────��──────────────
// 3. MOTOR FUNCTION OUTCOME RECORD
//    Tracks improvement/regression of gross motor function over time.
//    "Number with improved gross motor function outcomes" =
//    COUNT WHERE outcomeDirection = IMPROVED
// ─────────────────────────────────────────────
model MotorFunctionOutcome {
  id         String          @id @default(uuid())
  patientId  String
  patient    CpPatient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assessorId String
  assessor   ServiceProvider @relation(fields: [assessorId], references: [id], onDelete: Cascade)

  // GMFCS levels (1-5, lower = better)
  baselineLevel      Int // GMFCS level at start of period
  currentLevel       Int // GMFCS level at review
  baselineDate       DateTime
  reviewDate         DateTime
  outcomeDirection   OutcomeDirection // IMPROVED | STABLE | REGRESSED
  percentageChange   Float? // computed; store for quick aggregation
  notes              String?
  assessmentToolUsed String? // e.g., "GMFCS", "MACS", "CFCS"
  metadata           Json             @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([assessorId])
  @@index([outcomeDirection])
  @@index([reviewDate])
}

// ─────────────────────────────────────────────
// 4. PROVIDER ACTIVITY PARTICIPATION LOG
//    Tracks which patients participated in which activities/tasks
//    under a given provider — satisfies:
//    "Number participating in each activity by each professional"
// ─────────────────────────────────────────────
model ActivityParticipationLog {
  id         String          @id @default(uuid())
  patientId  String
  patient    CpPatient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  taskId     String?
  task       RehabTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  activityName     String // activity label (can mirror task title or be standalone)
  activityCategory String? // e.g., "Physiotherapy", "Speech", "OT"
  participatedOn   DateTime
  durationMinutes  Int?
  outcome          String? // free text or coded outcome
  metadata         Json     @default("{}")

  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([providerId])
  @@index([participatedOn])
  @@index([activityCategory])
}

// ─────────────────────────────────────────────
// 5. PROVIDER METRICS SNAPSHOT
//    Periodic (daily/weekly/monthly) materialized snapshot
//    per provider. Computed by a background job / cron.
//    All "number of..." KPIs per professional land here.
// ─────────────────────────────────────────────
model ProviderMetricsSnapshot {
  id         String          @id @default(uuid())
  providerId String
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  snapshotDate DateTime // date the snapshot covers (midnight UTC)
  period       MetricPeriod @default(DAILY)

  // ── Child attendance ──
  totalChildrenAttended     Int @default(0) // distinct patients seen in period
  newChildrenAttended       Int @default(0) // first-time encounters in period
  returningChildrenAttended Int @default(0)

  // ── Activity participation ──
  totalActivitiesAssigned  Int @default(0)
  totalActivitiesCompleted Int @default(0)
  uniqueActivitiesTypes    Int @default(0)

  // ── Adherence ──
  totalAdheringPatients    Int   @default(0) // patients completing >= adherenceThresholdPct of tasks
  totalNonAdheringPatients Int   @default(0)
  adherenceThresholdPct    Float @default(80.0) // configurable threshold
  averageAdherenceRate     Float @default(0.0) // 0-100

  // ── Outcomes ──
  totalImprovedOutcomes  Int @default(0)
  totalStableOutcomes    Int @default(0)
  totalRegressedOutcomes Int @default(0)

  // ── Appointments ──
  appointmentsScheduled Int @default(0)
  appointmentsCompleted Int @default(0)
  appointmentsDeclined  Int @default(0)

  // ── Assessments ──
  assessmentsCompleted Int @default(0)
  referralsMade        Int @default(0)
  referralsReceived    Int @default(0)

  // ── Telehealth ──
  telehealthSessionsHosted Int @default(0)
  telehealthMinutesTotal   Int @default(0)

  metadata   Json     @default("{}")
  computedAt DateTime @default(now())

  @@unique([providerId, snapshotDate, period])
  @@index([providerId, period])
  @@index([snapshotDate])
}

// ─────────────────────────────────────────────
// 6. SYSTEM METRICS SNAPSHOT
//    Platform-wide aggregate. One row per period.
//    Satisfies all "total number of..." stakeholder KPIs.
// ─────────────────────────────────────────────
model SystemMetricsSnapshot {
  id           String       @id @default(uuid())
  snapshotDate DateTime
  period       MetricPeriod @default(DAILY)

  // ── Enrollment ──
  totalChildrenEnrolled     Int @default(0)
  newChildrenEnrolledPeriod Int @default(0)
  totalActiveEnrollments    Int @default(0)
  totalInactiveEnrollments  Int @default(0)

  // ── Professionals ──
  totalActiveProfessionals Int @default(0)
  totalChildrenAttendedTo  Int @default(0) // platform-wide distinct patients seen

  // ── Adherence ──
  totalAdheringPlatform    Int   @default(0)
  totalNonAdheringPlatform Int   @default(0)
  platformAdherenceRate    Float @default(0.0)

  // ── Outcomes ──
  totalImprovedGrossMotor  Int @default(0)
  totalStableGrossMotor    Int @default(0)
  totalRegressedGrossMotor Int @default(0)

  // ── Activities ──
  totalActivitiesAssigned   Int @default(0)
  totalActivitiesCompleted  Int @default(0)
  totalActivityParticipants Int @default(0)

  // ── Assessments & Referrals ──
  totalAssessmentsCompleted Int @default(0)
  totalReferralsMade        Int @default(0)

  // ── Telehealth ──
  totalTelehealthSessions Int @default(0)
  totalTelehealthMinutes  Int @default(0)

  // ── Appointments ──
  totalAppointments          Int @default(0)
  totalCompletedAppointments Int @default(0)

  metadata   Json     @default("{}")
  computedAt DateTime @default(now())

  @@unique([snapshotDate, period])
  @@index([snapshotDate, period])
}

// ─────────────────────────────────────────────
// 7. PATIENT METRICS SNAPSHOT
//    Per-patient periodic snapshot for caregiver dashboards.
// ──────────────────────────────���──────────────
model PatientMetricsSnapshot {
  id        String    @id @default(uuid())
  patientId String
  patient   CpPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  snapshotDate DateTime
  period       MetricPeriod @default(WEEKLY)

  tasksAssigned          Int               @default(0)
  tasksCompleted         Int               @default(0)
  tasksMissed            Int               @default(0)
  adherenceRate          Float             @default(0.0) // 0-100
  currentGmfcsLevel      Int?
  previousGmfcsLevel     Int?
  outcomeDirection       OutcomeDirection?
  appointmentsAttended   Int               @default(0)
  assessmentsCompleted   Int               @default(0)
  activitiesParticipated Int               @default(0)

  metadata   Json     @default("{}")
  computedAt DateTime @default(now())

  @@unique([patientId, snapshotDate, period])
  @@index([patientId, period])
}
