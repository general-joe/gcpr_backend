model TelehealthAuditLog {
  id                String           @id @default(uuid())
  roomId            String?
  userId            String?
  actionType        String
  actionDetails     Json             @default("{}")
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime         @default(now())
  serviceProviderId String?
  room              TelehealthRoom?  @relation(fields: [roomId], references: [id])
  serviceProvider   ServiceProvider? @relation(fields: [serviceProviderId], references: [id])
  user              User?            @relation(fields: [userId], references: [id])

  @@index([roomId])
  @@index([userId])
  @@index([createdAt])
}

model TelehealthIdempotencyKey {
  id        String    @id @default(uuid())
  key       String
  scope     String
  response  Json?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([key, scope])
}

model TelehealthRoleTemplate {
  id                 String                    @id @default(uuid())
  organizationId     String
  role               TelehealthParticipantRole
  defaultPermissions Json                      @default("{}")
  description        String?
  createdAt          DateTime                  @default(now())

  @@index([organizationId])
}

model Permission {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String?
  description         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now())
  gameRolePermissions GameRolePermission[]
  rolePermissions     RolePermission[]
  userPermissions     UserPermission[]
}

model AppRole {
  id                  String               @id @default(uuid())
  slug                String               @unique
  name                String?
  description         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now())
  gameRolePermissions GameRolePermission[]
  rolePermissions     RolePermission[]
  userRoles           UserRole[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         AppRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String              @id @default(uuid())
  userId    String
  roleId    String
  scopeType AssignmentScopeType @default(GLOBAL)
  scopeId   String?
  grantedBy String?
  grantedAt DateTime            @default(now())
  expiresAt DateTime?
  active    Boolean             @default(true)
  role      AppRole             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId])
  @@index([roleId])
}

model UserPermission {
  id           String              @id @default(uuid())
  userId       String
  permissionId String
  allowed      Boolean             @default(true)
  scopeType    AssignmentScopeType @default(GLOBAL)
  scopeId      String?
  grantedBy    String?
  grantedAt    DateTime            @default(now())
  permission   Permission          @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId, scopeType, scopeId])
  @@index([userId])
  @@index([permissionId])
}

model GameResource {
  id                 String               @id @default(uuid())
  title              String
  description        String?
  source             GameSource           @default(UPLOADED)
  externalProvider   String?
  externalId         String?
  files              String[]             @default([])
  thumbnail          String?
  tags               String[]             @default([])
  isPublished        Boolean              @default(false)
  publishedAt        DateTime?
  metadata           Json                 @default("{}")
  uploaderUserId     String
  uploaderProviderId String?
  allowedRoleSlugs   String[]             @default([])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  removedAt          DateTime?
  uploaderProvider   ServiceProvider?     @relation("ProviderUploadedGames", fields: [uploaderProviderId], references: [id])
  uploaderUser       User                 @relation("UserUploadedGames", fields: [uploaderUserId], references: [id], onDelete: Cascade)
  rolePermissions    GameRolePermission[]

  @@index([externalProvider, externalId])
  @@index([uploaderUserId])
  @@index([uploaderProviderId])
}

model GameRolePermission {
  id           String       @id @default(uuid())
  gameId       String
  roleId       String
  permissionId String
  createdAt    DateTime     @default(now())
  game         GameResource @relation(fields: [gameId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         AppRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([gameId, roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model TaskAdherenceLog {
  id         String          @id @default(uuid())
  taskId     String
  patientId  String
  providerId String
