  inviteeUserId   String?
  inviteeUser     User?          @relation(fields: [inviteeUserId], references: [id], onDelete: SetNull)
  inviteeEmail    String?
  inviteePhone    String?
  inviteTokenHash String?
  expiresAt       DateTime?
  status          String         @default("sent") // e.g., sent/accepted/declined/expired
  deliveredVia    String?
  deliveredAt     DateTime?
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now())

  @@index([roomId])
  @@index([inviteeEmail])
}

model TelehealthMessage {
  id           String                     @id @default(uuid())
  roomId       String
  room         TelehealthRoom             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderUserId String?
  sender       User?                      @relation("TeleMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderRole   TelehealthParticipantRole?
  messageType  TelehealthMessageType      @default(text)
  content      String?
  attachments  Json                       @default("[]") // array of attachments metadata
  sequence     Int                        @default(autoincrement())
  visibleTo    Json                       @default("null")
  metadata     Json                       @default("{}")
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime                   @default(now())

  @@index([roomId, createdAt])
  @@index([sequence])
}

model TelehealthRecording {
  id                  String                   @id @default(uuid())
  roomId              String
  room                TelehealthRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  providerRecordingId String?
  s3Bucket            String?
  s3Key               String?
  storageClass        String?
  encryptionKeyId     String?
  sizeBytes           BigInt?
  durationSeconds     Int?
  state               TelehealthRecordingState @default(processing)
  metadata            Json                     @default("{}")
  createdAt           DateTime                 @default(now())
