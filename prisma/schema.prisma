  @@unique([taskId, logDate])
  @@index([patientId, logDate])
  @@index([providerId, logDate])
  @@index([status])
}

model PatientEnrollmentRecord {
  id               String           @id @default(uuid())
  patientId        String           @unique
  enrolledAt       DateTime         @default(now())
  enrolledByUserId String
  status           EnrollmentStatus @default(ACTIVE)
  programName      String?
  unenrolledAt     DateTime?
  unenrollReason   String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  patient          CpPatient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([enrolledAt])
}

model MotorFunctionOutcome {
  id                 String           @id @default(uuid())
  patientId          String
  assessorId         String
  baselineLevel      Int
  currentLevel       Int
  baselineDate       DateTime
  reviewDate         DateTime
  outcomeDirection   OutcomeDirection
