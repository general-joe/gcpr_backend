# Copy to .env (never commit .env). All values below are placeholders.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gcpr"
GCPR_API_URL=http://localhost:3001
PORT=3001

# Auth
JWT=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=30
TERMS_VERSION=1.0
PRIVACY_POLICY_VERSION=1.0
BOOTSTRAP_SECRET=replace-me
BOOTSTRAP_DISABLED=false
ALLOW_HTTP_MIGRATIONS=false

# Seed admin (required by scripts/seed-admin.js — no defaults exist)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-12-plus-char-strong-password

# Integrations (placeholders — real keys live in the deployment secret store)
RESEND_API_KEY=
HUBTEL_CLIENTID=
HUBTEL_SECRET=
HUBTEL_SENDER=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=./src/config/firebase-service-account.json
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=
GEMINI_API_KEY=
